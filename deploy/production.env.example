PAPYRUS_VERSION=0.0.1
API_DOMAIN=api.papyrus-reader.com
SYNC_DOMAIN=sync.papyrus-reader.com
APP_DOMAIN=app.papyrus-reader.com
DEBUG=false
HOST=0.0.0.0
PORT=8080
API_PREFIX=/v1
CORS_ORIGINS=["https://app.papyrus-reader.com"]
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
RATE_LIMIT_AUTH=5
RATE_LIMIT_GENERAL=100
RATE_LIMIT_UPLOAD=60
RATE_LIMIT_BATCH=300
FORWARDED_ALLOW_IPS=
POSTGRES_USER=papyrus
POSTGRES_DB=papyrus
POSTGRES_PASSWORD=
POWERSYNC_SOURCE_PASSWORD=
POWERSYNC_STORAGE_USER=powersync_storage
POWERSYNC_STORAGE_DB=powersync_storage
POWERSYNC_STORAGE_PASSWORD=
POWERSYNC_JWT_KEY_ID=papyrus-powersync-v1
POWERSYNC_JWT_AUDIENCE=papyrus-production
APP_PUBLIC_BASE_URL=https://app.papyrus-reader.com
OAUTH_ALLOWED_REDIRECT_SCHEMES=["papyrus"]
OAUTH_ALLOWED_REDIRECT_HOSTS=["app.papyrus-reader.com"]
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
EMAIL_DELIVERY_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Papyrus
ACQUISITION_ENABLED=false
OPDS_RELAY_ENABLED=true

# Optional server-held token with Issues write permission for PapyrusReader/client.
# Attachment uploads also require the token owner to have repository write access.
SUPPORT_GITHUB_TOKEN=

# Support routing. Token also needs organization Projects write access.
SUPPORT_GITHUB_REPOSITORY=PapyrusReader/client
SUPPORT_GITHUB_ASSIGNEE=Eoic
SUPPORT_GITHUB_PROJECT_OWNER=PapyrusReader
SUPPORT_GITHUB_PROJECT_NUMBER=1
SUPPORT_GITHUB_BUG_LABEL=bug
SUPPORT_GITHUB_FEATURE_LABEL=enhancement
SUPPORT_GITHUB_BUG_TYPE=Bug
SUPPORT_GITHUB_FEATURE_TYPE=Feature
SUPPORT_GITHUB_STATUS_FIELD=Status
SUPPORT_GITHUB_STATUS=Backlog
SUPPORT_GITHUB_KIND_FIELD=Kind
SUPPORT_GITHUB_KIND=Task
